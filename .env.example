# Copy to .env; never commit real values. Use separate secrets for every environment.
# Bare public domain whose DNS A/AAAA records point to the server.
PUBLIC_DOMAIN=
DEMO_PAYMENT_ENABLED=false
BACKUP_INTERVAL_SECONDS=86400

POSTGRES_USER=booking_hotel
# Generate independently with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Generate independently with: openssl rand -hex 32
# The same JWT_SECRET is supplied to auth and all services verifying JWT.
JWT_SECRET=

# Optional SMTP configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
